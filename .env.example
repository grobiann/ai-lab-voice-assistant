# .env.example — API 키 설정 예시
# 이 파일을 .env 로 복사하고 실제 키를 입력하세요
# cp .env.example .env

# ── tier3 LLM 교정 백엔드 설정 ──────────────────────────────────────────────────
# config.py 의 LLM_BACKEND 값에 따라 해당 키만 필요합니다

# LLM_BACKEND = "ollama"  → API 키 불필요 (Ollama 로컬 실행)

# LLM_BACKEND = "groq"    → 무료 API 키 필요 (발급: https://console.groq.com)
GROQ_API_KEY=gsk_...

# LLM_BACKEND = "claude"  → 유료 API 키 필요
ANTHROPIC_API_KEY=sk-ant-...

# ── cloud STT 모드 (STT_MODE = "cloud") ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── cloud_google STT 모드 (STT_MODE = "cloud_google") ───────────────────────────
# 발급: https://console.cloud.google.com → API 키 생성 → Speech-to-Text API 활성화
# 또는 서비스 계정 JSON: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GOOGLE_API_KEY=AIza...

# ── cloud_azure STT 모드 (STT_MODE = "cloud_azure") ─────────────────────────────
# 발급: https://portal.azure.com → Speech services 리소스 → 키 및 엔드포인트
# 지역: koreacentral / eastus / japaneast / southeastasia 등
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=koreacentral
