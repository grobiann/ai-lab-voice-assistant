# Path to the Vosk Korean model directory
# Download with: npm run download-model
MODEL_PATH=./models/vosk-model-small-ko-0.22

# Audio input device (leave empty to use system default)
# List devices with: arecord -l  OR  sox -n -d stat 2>&1
AUDIO_DEVICE=

# Recording program: 'arecord' (Linux/ALSA) or 'sox'
RECORD_PROGRAM=arecord

# Words that trigger activation (comma-separated, Korean + English fallbacks)
WAKE_WORDS=클로드,claude,클로디

# Words that deactivate and return to listening mode (comma-separated)
DEACTIVATE_WORDS=취소,그만,cancel,stop

# Claude window title patterns to search for (comma-separated)
CLAUDE_WINDOW_NAMES=Claude,claude.ai

# Path to Claude desktop app (optional, used if window not found)
# CLAUDE_APP_PATH=/usr/bin/claude
# CLAUDE_APP_PATH=/opt/Claude/claude
